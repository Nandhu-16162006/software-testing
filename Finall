package javatesting;
public class finallinst {
	public static void main(String[]args) 
	{
		try
		{
		int a=18;
		int b=2;
		int result=a/b;
            System.out.println("Result :" + result);
		}
		catch( ArithmeticException e)
		{
			System.out.println("Enter The Value ");
		}
		finally
		{
			System.out.println("End Of The Process");
			
		}
	}
}
		
	
		
